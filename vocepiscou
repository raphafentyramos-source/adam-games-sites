}


/* =========================================================
   VARIÁVEIS DE TEMPO
========================================================= */

let levelStartTime = 0;


/* =========================================================
   TIMER DO NÍVEL
========================================================= */

function startLevelTimer(){

    clearInterval(timerInterval);

    currentTimerDuration = 0;

    if(currentLevel === 8){

        currentTimerDuration = 20000;

        timerWrap.classList.remove("hidden");

        timerBar.style.width = "100%";

        timerInterval = setInterval(
            ()=>{
                if(!active){
                    return;
                }

                const elapsed =
                    performance.now() - levelStartTime;

                const remaining =
                    currentTimerDuration - elapsed;

                if(elapsed >= 10000){

                    rewardValueEl.textContent =
                        "🪙 75";

                }else{

                    rewardValueEl.textContent =
                        "🪙 100";

                }

                if(remaining <= 0){

                    clearInterval(timerInterval);

                    failLevel(
                        "O tempo acabou."
                    );

                    return;
                }

                timerBar.style.width =
                    (remaining / currentTimerDuration * 100) + "%";

            },
            40
        );

    }

    else if(currentLevel === 9){

        currentTimerDuration = 30000;

        timerWrap.classList.remove("hidden");

        timerBar.style.width = "100%";

        timerInterval = setInterval(
            ()=>{
                if(!active){
                    return;
                }

                const elapsed =
                    performance.now() - levelStartTime;

                const remaining =
                    currentTimerDuration - elapsed;

                let reward = 200;

                if(elapsed > 10000){
                    reward = 150;
                }

                if(elapsed > 20000){
                    reward = 120;
                }

                rewardValueEl.textContent =
                    "🪙 " + reward;

                if(remaining <= 0){

                    clearInterval(timerInterval);

                    failLevel(
                        "O tempo acabou."
                    );

                    return;
                }

                timerBar.style.width =
                    (remaining / currentTimerDuration * 100) + "%";

            },
            40
        );

    }

}


/* =========================================================
   RODAR DESAFIO
========================================================= */

function runChallenge(){

    if(!active){
        return;
    }

    clearTimeout(levelTimeout);

    clearTarget();

    currentChallengeId++;

    const challengeId =
        currentChallengeId;

    const type =
        GAME_CONFIG.levels[currentLevel].type;

    if(type === "tap"){

        runTapChallenge(challengeId);

    }

    else if(type === "color"){

        runColorChallenge(challengeId);

    }

    else if(type === "appear"){

        runAppearChallenge(challengeId);

    }

    else if(type === "avoid"){

        runAvoidChallenge(challengeId);

    }

    else if(type === "inverse"){

        runInverseChallenge(challengeId);

    }

    else if(type === "side"){

        runSideChallenge(challengeId);

    }

    else if(type === "extreme"){

        runExtremeChallenge(challengeId);

    }

    else if(type === "hard"){

        runHardChallenge(challengeId);

    }

    else if(type === "supreme"){

        runSupremeChallenge(challengeId);

    }

}


/* =========================================================
   POSIÇÃO ALEATÓRIA
========================================================= */

function randomPosition(){

    const rect =
        gameArea.getBoundingClientRect();

    const margin = 65;

    const x =
        random(
            margin,
            Math.max(
                margin + 1,
                Math.floor(rect.width - margin)
            )
        );

    const y =
        random(
            margin,
            Math.max(
                margin + 1,
                Math.floor(rect.height - margin)
            )
        );

    return {x,y};
}


/* =========================================================
   CRIAR ALVO
========================================================= */

function createTarget(options = {}){

    clearTarget();

    const target =
        document.createElement("div");

    target.className =
        "target " +
        (options.className || "blue");

    target.textContent =
        options.text || "⚡";

    const pos =
        options.position ||
        randomPosition();

    target.style.left =
        pos.x + "px";

    target.style.top =
        pos.y + "px";

    if(options.fake){

        target.classList.add("fake");

    }

    target.dataset.correct =
        options.correct
            ? "true"
            : "false";

    target.dataset.role =
        options.role || "normal";

    target.addEventListener(
        "pointerdown",
        function(event){

            event.preventDefault();

            handleTargetPress(target);

        },
        {passive:false}
    );

    gameArea.appendChild(target);

    targetActive = true;

    targetStartedAt =
        performance.now();

    return target;
}


/* =========================================================
   LIMPAR ALVO
========================================================= */

function clearTarget(){

    gameArea
        .querySelectorAll(".target")
        .forEach(
            element => element.remove()
        );

    targetActive = false;
}


/* =========================================================
   LIMPAR ÁREA
========================================================= */

function clearGameArea(){

    gameArea
        .querySelectorAll(
            ".target,.side-button,.hard-text"
        )
        .forEach(
            element => element.remove()
        );
}


/* =========================================================
   CLIQUE NO ALVO
========================================================= */

function handleTargetPress(target){

    if(!active || !targetActive){
        return;
    }

    const correct =
        target.dataset.correct === "true";

    const reaction =
        performance.now() - targetStartedAt;

    if(!correct){

        failOrLoseLife();

        return;
    }

    targetActive = false;

    totalReaction += reaction;

    reactionCount++;

    roundCount++;

    combo++;

    const speedBonus =
        Math.max(
            10,
            Math.round(
                100 -
                clamp(
                    reaction / 10,
                    0,
                    90
                )
            )
        );

    score +=
        speedBonus +
        (combo >= 5 ? 20 : 0);

    sound("success");

    updateCombo();

    clearTarget();

    if(shouldFinishLevel()){

        completeLevel();

        return;
    }

    const delay =
        currentLevel >= 7
            ? random(220,550)
            : random(350,700);

    levelTimeout =
        setTimeout(
            runChallenge,
            delay
        );

    updateHUD();
}


/* =========================================================
   FIM DO NÍVEL
========================================================= */

function shouldFinishLevel(){

    if(currentLevel <= 3){
        return roundCount >= 5;
    }

    if(currentLevel === 4){
        return roundCount >= 7;
    }

    if(currentLevel === 5){
        return roundCount >= 8;
    }

    if(currentLevel === 6){
        return roundCount >= 9;
    }

    if(currentLevel === 7){
        return roundCount >= 10;
    }

    if(currentLevel === 8){
        return roundCount >= 10;
    }

    if(currentLevel === 9){
        return roundCount >= 20;
    }

    return false;
}


