/* =========================================================
   CORES
========================================================= */

function getColor(className){

    const colors = {

        green:"#27e27b",

        red:"#ff3f62",

        blue:"#3d7cff",

        yellow:"#ffd43b",

        purple:"#9d5cff"

    };

    return colors[className] || "#fff";
}


/* =========================================================
   VIDAS
========================================================= */

function renderLives(){

    lifeBar.innerHTML = "";

    if(currentLevel < 4){

        lifeBar.classList.add("hidden");

        return;

    }

    lifeBar.classList.remove("hidden");

    for(let i=0;i<3;i++){

        const life =
            document.createElement("span");

        life.className =
            "life " +
            (i >= lives ? "off" : "");

        life.textContent =
            "❤️";

        lifeBar.appendChild(life);

    }

}


/* =========================================================
   COMBO
========================================================= */

function updateCombo(){

    if(combo < 2){

        comboEl.textContent = "";

        return;
    }

    let multiplier = 1;

    if(combo >= 5){
        multiplier = 2;
    }

    if(combo >= 10){
        multiplier = 3;
    }

    if(combo >= 20){
        multiplier = 5;
    }

    comboEl.textContent =
        "🔥 COMBO " +
        combo +
        " • x" +
        multiplier;

}


/* =========================================================
   ERRO / VIDA
========================================================= */

function failOrLoseLife(){

    sound("error");

    combo = 0;

    lives--;

    renderLives();

    clearTarget();

    if(lives <= 0){

        failLevel(
            "Você perdeu todas as vidas."
        );

        return;
    }

    showToast(
        "❌ Errou! Cuidado!",
        "error"
    );

    setTimeout(
        runChallenge,
        500
    );

}


/* =========================================================
   PERDEU A FASE
========================================================= */

function failLevel(reason){

    if(!active){
        return;
    }

    clearTimers();

    clearTarget();

    targetActive = false;

    sound("error");

    combo = 0;

    rewardValueEl.textContent =
        "🪙 0";

    modalLevel.textContent =
        "NÍVEL " + currentLevel;

    modalTitle.textContent =
        "💀 VOCÊ PISCOU!";

    modalRule.textContent =
        reason;

    modalDescription.textContent =
        "Você perdeu este desafio. Pode continuar gastando uma chance.";

    modalButtons.innerHTML = "";

    const canContinue =
        chances >= GAME_CONFIG.continueChance;

    if(canContinue){

        const continueBtn =
            document.createElement("button");

        continueBtn.className =
            "modal-btn primary-btn";

        continueBtn.textContent =
            "❤️ CONTINUAR  •  -1 CHANCE  +30 🪙";

        continueBtn.onclick =
            continueAfterFail;

        modalButtons.appendChild(
            continueBtn
        );

    }else{

        const noChance =
            document.createElement("div");

        noChance.className =
            "rule";

        noChance.textContent =
            "Você não tem mais chances para continuar.";

        modalButtons.appendChild(
            noChance
        );

    }

    const exitBtn =
        document.createElement("button");

    exitBtn.className =
        "modal-btn danger-btn";

    exitBtn.textContent =
        "🏠 SAIR DO JOGO";

    exitBtn.onclick =
        endGame;

    modalButtons.appendChild(
        exitBtn
    );

    openModal();

}


/* =========================================================
   CONTINUAR DEPOIS DA MORTE
========================================================= */

function continueAfterFail(){

    if(chances < GAME_CONFIG.continueChance){

        showToast(
            "Sem chances para continuar.",
            "error"
        );

        return;
    }

    chances -=
        GAME_CONFIG.continueChance;

    coins +=
        GAME_CONFIG.continueReward;

    challengeNumber++;

    combo = 0;

    roundCount = 0;

    lives = 3;

    inverseRule =
        Math.random() < .5;

    saveState();

    closeModal();

    showToast(
        "+30 moedas • novo desafio!",
        "success"
    );

    setTimeout(
        ()=>{
            showLevelIntro();
        },
        650
    );

}


/* =========================================================
   COMPLETOU NÍVEL
========================================================= */

function completeLevel(){

    if(!active){
        return;
    }

    clearTimers();

    clearTarget();

    targetActive = false;

    const reward =
        getCurrentReward();

    coins += reward;

    const average =
        reactionCount > 0
            ? Math.round(
                totalReaction /
                reactionCount
            )
            : 0;

    score +=
        reward * 10;

    if(score > bestScore){

        bestScore = score;

    }

    saveState();

    sound("coin");

    if(currentLevel >= 9){

        finishGame(
            reward,
            average
        );

        return;
    }

    const completedLevel =
        currentLevel;

    currentLevel++;

    roundCount = 0;

    lives = 3;

    totalReaction = 0;

    reactionCount = 0;

    combo = 0;

    showToast(
        "+" + reward + " moedas!",
        "success"
    );

    setTimeout(
        ()=>{
            showLevelIntro();
        },
        700
    );

}


/* =========================================================
   FINAL DO JOGO
========================================================= */

function finishGame(
    reward,
    average
){

    clearTimers();

    active = false;

    modalLevel.textContent =
        "DESAFIO CONCLUÍDO";

    modalTitle.textContent =
        "👑 REAÇÃO SUPREMA!";

    modalRule.textContent =
        "Você chegou ao final do NÃO PISQUE!";

    modalDescription.textContent =
        "Recompensa recebida: " +
        reward +
        " moedas.";

    modalButtons.innerHTML = `

        <div class="result-details">

            <div class="result-detail">
                <strong>${score}</strong>
                <span>PONTUAÇÃO</span>
            </div>

            <div class="result-detail">
                <strong>${average || "—"} ms</strong>
                <span>REAÇÃO MÉDIA</span>
            </div>

        </div>

        <button
            class="modal-btn primary-btn"
            onclick="resetToHome()"
        >
            🏠 VOLTAR AO MENU
        </button>

    `;

    openModal();

    updateHUD();

}


/* =========================================================
   SAIR
========================================================= */

function endGame(){

    clearTimers();

    clearGameArea();

    active = false;

    targetActive = false;

    score = 0;

    combo = 0;

    currentLevel = 1;

    closeModal();

    resetToHome();

}


/* =========================================================
   VOLTAR AO MENU
========================================================= */

function resetToHome(){

    clearTimers();

    clearGameArea();

    active = false;

    targetActive = false;

    score = 0;

    combo = 0;

    currentLevel = 1;

    roundCount = 0;

    totalReaction = 0;

    reactionCount = 0;

    game.classList.remove("active");

    game.style.display = "";

    home.style.display = "flex";

    closeModal();

    updateHUD();

}


/* =========================================================
   TIMERS
========================================================= */

function clearTimers(){

    clearTimeout(levelTimeout);

    clearInterval(timerInterval);

    levelTimeout = null;

    timerInterval = null;

}


/* =========================================================
   PREVENIR CLIQUES ACIDENTAIS FORA DO ALVO
========================================================= */

gameArea.addEventListener(
    "pointerdown",
    function(event){

        if(!active){
            return;
        }

        const target =
            event.target.closest(".target");

        const side =
            event.target.closest(".side-button");

        const hard =
            event.target.closest(".hard-text");

        if(
            !target &&
            !side &&
            !hard
        ){

            if(
                currentLevel === 4 ||
                currentLevel === 5 ||
                currentLevel === 7 ||
                currentLevel === 9
            ){

                failOrLoseLife();

            }

        }

    },
    {passive:false}
);


/* =========================================================
   VISIBILIDADE DA PÁGINA
========================================================= */

document.addEventListener(
    "visibilitychange",
    ()=>{
        if(
            document.hidden &&
            active
        ){

            /*
             * Não encerramos a partida automaticamente.
             * Apenas evitamos ações perigosas enquanto
             * a página estiver fora de foco.
             */

        }
    }
);


/* =========================================================
   INICIALIZAÇÃO
========================================================= */

updateHUD();

</script>

