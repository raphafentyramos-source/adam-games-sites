<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<title>NÃO PISQUE! • Adam Games</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    -webkit-tap-highlight-color:transparent;
}

:root{
    --bg:#07111f;
    --panel:#0d1c30;
    --panel2:#122641;
    --line:rgba(255,255,255,.10);
    --text:#ffffff;
    --muted:#91a3ba;
    --cyan:#00eaff;
    --blue:#3d7cff;
    --green:#27e27b;
    --yellow:#ffd43b;
    --orange:#ff9f2d;
    --red:#ff3f62;
    --purple:#9d5cff;
}

html,
body{
    width:100%;
    min-height:100%;
    background:
        radial-gradient(circle at 50% -10%, #173c65 0%, transparent 40%),
        linear-gradient(180deg,#07111f 0%,#040912 100%);
    color:var(--text);
    font-family:Arial,Helvetica,sans-serif;
}

body{
    min-height:100vh;
    overflow-x:hidden;
}

button{
    font:inherit;
    border:0;
    cursor:pointer;
}

.hidden{
    display:none !important;
}

/* =========================================================
   APP
========================================================= */

.app{
    min-height:100vh;
    display:flex;
    flex-direction:column;
}

.topbar{
    width:100%;
    padding:14px 14px 10px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    position:relative;
    z-index:10;
}

.brand{
    font-weight:900;
    letter-spacing:.5px;
    font-size:17px;
}

.brand span{
    color:var(--cyan);
}

.stats{
    display:flex;
    gap:7px;
    align-items:center;
}

.stat{
    background:rgba(255,255,255,.07);
    border:1px solid var(--line);
    border-radius:14px;
    padding:7px 10px;
    font-size:13px;
    font-weight:800;
    white-space:nowrap;
}

.stat.coins{
    color:#ffd84a;
}

.stat.chances{
    color:#ff6d87;
}

.stat.score{
    color:#75eaff;
}

.main{
    width:100%;
    max-width:760px;
    margin:0 auto;
    padding:12px 14px 30px;
    flex:1;
    display:flex;
    flex-direction:column;
}

/* =========================================================
   HOME
========================================================= */

.home{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    min-height:calc(100vh - 90px);
    text-align:center;
}

.logo{
    font-size:clamp(42px,13vw,86px);
    line-height:.88;
    font-weight:1000;
    letter-spacing:-4px;
    text-shadow:
        0 0 18px rgba(0,234,255,.25),
        0 8px 30px rgba(0,0,0,.5);
}

.logo .accent{
    color:var(--cyan);
}

.tagline{
    margin-top:18px;
    color:var(--muted);
    font-size:16px;
}

.home-card{
    width:100%;
    max-width:470px;
    margin-top:30px;
    padding:20px;
    background:linear-gradient(180deg,rgba(18,38,65,.95),rgba(10,23,40,.95));
    border:1px solid var(--line);
    border-radius:24px;
    box-shadow:0 20px 60px rgba(0,0,0,.35);
}

.cost{
    display:flex;
    justify-content:center;
    gap:10px;
    flex-wrap:wrap;
    margin-bottom:18px;
}

.cost-item{
    padding:9px 13px;
    border-radius:12px;
    background:rgba(255,255,255,.06);
    font-weight:800;
}

.cost-item:first-child{
    color:#ffd84a;
}

.cost-item:last-child{
    color:#ff7089;
}

.primary{
    width:100%;
    min-height:58px;
    border-radius:17px;
    background:linear-gradient(135deg,#00eaff,#3d7cff);
    color:#00131c;
    font-weight:1000;
    font-size:18px;
    box-shadow:0 10px 35px rgba(0,190,255,.25);
    transition:.15s;
}

.primary:active{
    transform:scale(.97);
}

.primary:disabled{
    opacity:.45;
    cursor:not-allowed;
}

.home-record{
    margin-top:18px;
    color:var(--muted);
    font-size:13px;
}

/* =========================================================
   GAME
========================================================= */

.game{
    display:none;
    flex-direction:column;
    flex:1;
}

.game.active{
    display:flex;
}

.level-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin-bottom:12px;
}

.level-name{
    font-size:20px;
    font-weight:1000;
}

.level-name small{
    display:block;
    color:var(--muted);
    font-size:11px;
    margin-top:3px;
    letter-spacing:1px;
    text-transform:uppercase;
}

.reward{
    text-align:right;
    font-weight:1000;
    color:#ffd84a;
}

.reward small{
    display:block;
    color:var(--muted);
    font-size:10px;
}

.timer-wrap{
    width:100%;
    height:9px;
    background:rgba(255,255,255,.07);
    border-radius:20px;
    overflow:hidden;
    margin-bottom:12px;
}

.timer-bar{
    height:100%;
    width:100%;
    background:linear-gradient(90deg,#27e27b,#ffd43b,#ff3f62);
    transform-origin:left;
    transition:width .05s linear;
}

.game-area{
    position:relative;
    width:100%;
    flex:1;
    min-height:500px;
    max-height:720px;
    border-radius:28px;
    overflow:hidden;
    background:
        radial-gradient(circle at 50% 45%,rgba(39,226,255,.07),transparent 35%),
        linear-gradient(180deg,#0c1d32,#07111e);
    border:1px solid rgba(255,255,255,.09);
    box-shadow:inset 0 0 60px rgba(0,0,0,.25);
}

.game-area::before{
    content:"";
    position:absolute;
    inset:0;
    background-image:
        linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
    background-size:35px 35px;
    pointer-events:none;
}

.center-message{
    position:absolute;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
    text-align:center;
    color:var(--muted);
    width:85%;
    z-index:2;
}

.center-message strong{
    display:block;
    font-size:28px;
    color:#fff;
    margin-bottom:8px;
}

.target{
    position:absolute;
    width:88px;
    height:88px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:30px;
    font-weight:1000;
    box-shadow:
        0 0 0 8px rgba(255,255,255,.05),
        0 0 35px rgba(0,234,255,.3);
    transform:translate(-50%,-50%);
    z-index:5;
    user-select:none;
}

.target.green{
    background:#27e27b;
    color:#052012;
}

.target.red{
    background:#ff3f62;
    color:#fff;
}

.target.blue{
    background:#3d7cff;
    color:#fff;
}

.target.yellow{
    background:#ffd43b;
    color:#302500;
}

.target.purple{
    background:#9d5cff;
    color:#fff;
}

.target.fake{
    animation:fakePulse .35s infinite alternate;
}

@keyframes fakePulse{
    from{transform:translate(-50%,-50%) scale(.92)}
    to{transform:translate(-50%,-50%) scale(1.05)}
}

.side-button{
    position:absolute;
    top:0;
    bottom:0;
    width:50%;
    background:transparent;
    color:rgba(255,255,255,.15);
    font-size:50px;
    z-index:3;
}

.side-button.left{
    left:0;
}

.side-button.right{
    right:0;
}

.side-button:active{
    background:rgba(255,255,255,.03);
}

.life-bar{
    display:flex;
    justify-content:center;
    gap:6px;
    margin-top:12px;
}

.life{
    font-size:23px;
    filter:drop-shadow(0 0 5px rgba(255,70,100,.25));
}

.life.off{
    opacity:.18;
    filter:none;
}

.combo{
    text-align:center;
    margin-top:10px;
    min-height:22px;
    font-size:14px;
    font-weight:900;
    color:#ffd84a;
}

/* =========================================================
   MODAL
========================================================= */

.overlay{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.72);
    backdrop-filter:blur(9px);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
    z-index:100;
}

.modal{
    width:100%;
    max-width:430px;
    background:
        radial-gradient(circle at 50% 0%,rgba(0,234,255,.12),transparent 45%),
        linear-gradient(180deg,#122641,#091522);
    border:1px solid rgba(255,255,255,.13);
    border-radius:26px;
    padding:26px 22px 22px;
    text-align:center;
    box-shadow:0 30px 90px rgba(0,0,0,.6);
    animation:modalIn .2s ease;
}

@keyframes modalIn{
    from{opacity:0;transform:scale(.94) translateY(10px)}
    to{opacity:1;transform:scale(1) translateY(0)}
}

.modal-level{
    color:var(--cyan);
    font-size:12px;
    font-weight:1000;
    letter-spacing:2px;
    text-transform:uppercase;
}

.modal h2{
    margin-top:9px;
    font-size:31px;
    font-weight:1000;
}

.modal p{
    margin:13px auto 20px;
    line-height:1.5;
    color:#b8c5d5;
    max-width:340px;
}

.rule{
    padding:14px;
    border-radius:15px;
    background:rgba(255,255,255,.05);
    border:1px solid var(--line);
    margin-bottom:18px;
    color:#fff;
    font-weight:800;
}

.modal-buttons{
    display:flex;
    flex-direction:column;
    gap:9px;
}

.modal-btn{
    width:100%;
    min-height:52px;
    border-radius:15px;
    font-weight:1000;
}

.modal-btn.primary-btn{
    background:linear-gradient(135deg,#00eaff,#3d7cff);
    color:#00131c;
}

.modal-btn.secondary-btn{
    background:rgba(255,255,255,.07);
    color:#fff;
    border:1px solid var(--line);
}

.modal-btn.danger-btn{
    background:rgba(255,63,98,.12);
    color:#ff7187;
    border:1px solid rgba(255,63,98,.2);
}

/* =========================================================
   RESULT
========================================================= */

.result-icon{
    font-size:58px;
    margin-bottom:5px;
}

.result-score{
    font-size:34px;
    font-weight:1000;
    margin:12px 0;
}

.result-details{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin:15px 0 20px;
}

.result-detail{
    background:rgba(255,255,255,.05);
    border-radius:13px;
    padding:12px 8px;
}

.result-detail strong{
    display:block;
    font-size:19px;
}

.result-detail span{
    color:var(--muted);
    font-size:11px;
}

/* =========================================================
   TOAST
========================================================= */

.toast{
    position:fixed;
    left:50%;
    bottom:25px;
    transform:translate(-50%,20px);
    opacity:0;
    z-index:300;
    padding:12px 17px;
    background:#122641;
    border:1px solid var(--line);
    border-radius:14px;
    font-weight:900;
    pointer-events:none;
    transition:.2s;
    white-space:nowrap;
}

.toast.show{
    opacity:1;
    transform:translate(-50%,0);
}

.toast.success{
    color:#58ef9a;
}

.toast.error{
    color:#ff7187;
}

.toast.warning{
    color:#ffd84a;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:520px){
    .topbar{
        padding:11px 10px 8px;
    }

    .brand{
        font-size:14px;
    }

    .stat{
        padding:6px 8px;
        font-size:11px;
    }

    .main{
        padding:8px 10px 20px;
    }

    .game-area{
        min-height:calc(100vh - 245px);
        max-height:none;
    }

    .target{
        width:74px;
        height:74px;
        font-size:25px;
    }

    .logo{
        letter-spacing:-3px;
    }

    .modal{
        padding:23px 18px 18px;
    }
}
</style>
</head>

<body>

<div class="app">

    <!-- ================= TOP BAR ================= -->

    <header class="topbar">

        <div class="brand">
            ADAM <span>GAMES</span>
        </div>

        <div class="stats">

            <div class="stat coins">
                🪙 <span id="coins">500</span>
            </div>

            <div class="stat chances">
                ❤️ <span id="chances">5</span>
            </div>

            <div class="stat score">
                ⭐ <span id="score">0</span>
            </div>

        </div>

    </header>


    <main class="main">

        <!-- ================= HOME ================= -->

        <section id="home" class="home">

            <div class="logo">
                NÃO<br>
                <span class="accent">PISQUE!</span>
            </div>

            <div class="tagline">
                Seu reflexo aguenta?
            </div>

            <div class="home-card">

                <div class="cost">

                    <div class="cost-item">
                        🪙 30 moedas
                    </div>

                    <div class="cost-item">
                        ❤️ -1 chance
                    </div>

                </div>

                <button
                    id="startGameBtn"
                    class="primary"
                    onclick="startGame()"
                >
                    ⚡ JOGAR
                </button>

                <div class="home-record">
                    Melhor pontuação:
                    <strong id="bestScore">0</strong>
                </div>

            </div>

        </section>


        <!-- ================= GAME ================= -->

        <section id="game" class="game">

            <div class="level-header">

                <div class="level-name">
                    <span id="levelNumber">NÍVEL 1</span>

                    <small id="levelSubtitle">
                        TOQUE!
                    </small>
                </div>

                <div class="reward">

                    <small>RECOMPENSA</small>

                    <span id="rewardValue">
                        🪙 20
                    </span>

                </div>

            </div>


            <div
                id="timerWrap"
                class="timer-wrap hidden"
            >
                <div
                    id="timerBar"
                    class="timer-bar"
                ></div>
            </div>


            <div
                id="gameArea"
                class="game-area"
            >

                <div
                    id="centerMessage"
                    class="center-message"
                >
                    <strong>Prepare-se...</strong>
                    O desafio vai começar.
                </div>

            </div>


            <div
                id="lifeBar"
                class="life-bar hidden"
            ></div>


            <div
                id="combo"
                class="combo"
            ></div>

        </section>

    </main>

</div>


<!-- =====================================================
     MODAL
===================================================== -->

<div
    id="overlay"
    class="overlay hidden"
>

    <div class="modal">

        <div
            id="modalLevel"
            class="modal-level"
        >
            NÍVEL 1
        </div>

        <h2 id="modalTitle">
            TOQUE!
        </h2>

        <div
            id="modalRule"
            class="rule"
        >
            Reaja o mais rápido possível.
        </div>

        <p id="modalDescription">
            Quando o alvo aparecer, toque nele.
        </p>

        <div
            id="modalButtons"
            class="modal-buttons"
        >

            <button
                class="modal-btn primary-btn"
                onclick="modalPrimary()"
            >
                COMEÇAR
            </button>

        </div>

    </div>

</div>


<div
    id="toast"
    class="toast"
></div>


<script>
/* =========================================================
   NÃO PISQUE!
   Adam Games
========================================================= */


/* =========================================================
   CONFIGURAÇÃO
========================================================= */

const GAME_CONFIG = {

    entryCost: 30,

    entryChance: 1,

    continueChance: 1,

    continueReward: 30,

    startingCoins: 500,

    startingChances: 5,

    levels: {

        1:{
            title:"TOQUE!",
            subtitle:"REAÇÃO BÁSICA",
            reward:20,
            type:"tap"
        },

        2:{
            title:"CORRETA",
            subtitle:"COR CERTA",
            reward:20,
            type:"color"
        },

        3:{
            title:"APARECEU!",
            subtitle:"POSIÇÃO ALEATÓRIA",
            reward:20,
            type:"appear"
        },

        4:{
            title:"NÃO TOQUE!",
            subtitle:"EVITE O VERMELHO",
            reward:30,
            type:"avoid"
        },

        5:{
            title:"INVERTIDO",
            subtitle:"REGRA MUDOU",
            reward:30,
            type:"inverse"
        },

        6:{
            title:"ESQUERDA OU DIREITA",
            subtitle:"REFLEXO",
            reward:30,
            type:"side"
        },

        7:{
            title:"NÃO PISQUE",
            subtitle:"REFLEXO EXTREMO",
            reward:30,
            type:"extreme"
        },

        8:{
            title:"HARD",
            subtitle:"NÃO CONFIE NOS OLHOS",
            reward:100,
            type:"hard"
        },

        9:{
            title:"REAÇÃO SUPREMA",
            subtitle:"BÔNUS",
            reward:200,
            type:"supreme"
        }

    }

};


/* =========================================================
   ESTADO
========================================================= */

let coins = loadNumber("np_coins", GAME_CONFIG.startingCoins);

let chances = loadNumber(
    "np_chances",
    GAME_CONFIG.startingChances
);

let bestScore = loadNumber(
    "np_best_score",
    0
);

let score = 0;

let currentLevel = 1;

let challengeNumber = 1;

let combo = 0;

let lives = 3;

let active = false;

let targetActive = false;

let targetStartedAt = 0;

let timerInterval = null;

let levelTimeout = null;

let currentTimerDuration = 0;

let currentChallengeId = 0;

let inverseRule = false;

let roundCount = 0;

let totalReaction = 0;

let reactionCount = 0;


/* =========================================================
   ELEMENTOS
========================================================= */

const home = document.getElementById("home");

const game = document.getElementById("game");

const overlay = document.getElementById("overlay");

const coinsEl = document.getElementById("coins");

const chancesEl = document.getElementById("chances");

const scoreEl = document.getElementById("score");

const bestScoreEl = document.getElementById("bestScore");

const levelNumberEl = document.getElementById("levelNumber");

const levelSubtitleEl = document.getElementById("levelSubtitle");

const rewardValueEl = document.getElementById("rewardValue");

const gameArea = document.getElementById("gameArea");

const centerMessage = document.getElementById("centerMessage");

const lifeBar = document.getElementById("lifeBar");

const comboEl = document.getElementById("combo");

const timerWrap = document.getElementById("timerWrap");

const timerBar = document.getElementById("timerBar");

const modalLevel = document.getElementById("modalLevel");

const modalTitle = document.getElementById("modalTitle");

const modalRule = document.getElementById("modalRule");

const modalDescription = document.getElementById("modalDescription");

const modalButtons = document.getElementById("modalButtons");

const toast = document.getElementById("toast");


/* =========================================================
   STORAGE
========================================================= */

function loadNumber(key, fallback){

    const value = localStorage.getItem(key);

    if(value === null){
        return fallback;
    }

    const parsed = Number(value);

    return Number.isFinite(parsed)
        ? parsed
        : fallback;
}


function saveState(){

    localStorage.setItem("np_coins", coins);

    localStorage.setItem("np_chances", chances);

    localStorage.setItem("np_best_score", bestScore);

    updateHUD();
}


/* =========================================================
   HUD
========================================================= */

function updateHUD(){

    coinsEl.textContent = coins;

    chancesEl.textContent = chances;

    scoreEl.textContent = score;

    bestScoreEl.textContent = bestScore;
}


/* =========================================================
   UTILIDADES
========================================================= */

function random(min,max){

    return Math.floor(
        Math.random() * (max - min + 1)
    ) + min;
}


function clamp(value,min,max){

    return Math.max(
        min,
        Math.min(max,value)
    );
}


function sleep(ms){

    return new Promise(
        resolve => setTimeout(resolve,ms)
    );
}


/* =========================================================
   SOM
========================================================= */

let audioContext = null;


function sound(type){

    try{

        if(!audioContext){

            audioContext =
                new (window.AudioContext ||
                window.webkitAudioContext)();

        }

        const oscillator =
            audioContext.createOscillator();

        const gain =
            audioContext.createGain();

        oscillator.connect(gain);

        gain.connect(audioContext.destination);

        let frequency = 500;

        if(type === "success"){
            frequency = 720;
        }

        if(type === "error"){
            frequency = 150;
        }

        if(type === "coin"){
            frequency = 900;
        }

        if(type === "start"){
            frequency = 420;
        }

        oscillator.frequency.value = frequency;

        oscillator.type = "sine";

        gain.gain.setValueAtTime(
            .0001,
            audioContext.currentTime
        );

        gain.gain.exponentialRampToValueAtTime(
            .08,
            audioContext.currentTime + .01
        );

        gain.gain.exponentialRampToValueAtTime(
            .0001,
            audioContext.currentTime + .13
        );

        oscillator.start();

        oscillator.stop(
            audioContext.currentTime + .14
        );

    }catch(error){

        // Som é opcional.

    }

}


/* =========================================================
   TOAST
========================================================= */

let toastTimeout = null;


function showToast(text,type=""){

    clearTimeout(toastTimeout);

    toast.textContent = text;

    toast.className =
        "toast show " + type;

    toastTimeout = setTimeout(
        ()=>{
            toast.className = "toast";
        },
        1800
    );
}


/* =========================================================
   MODAL
========================================================= */

function openModal(){

    overlay.classList.remove("hidden");
}


function closeModal(){

    overlay.classList.add("hidden");
}


/* =========================================================
   DESCRIÇÕES
========================================================= */

function getLevelInfo(level){

    const data = GAME_CONFIG.levels[level];

    return data;
}


function showLevelIntro(){

    const info =
        getLevelInfo(currentLevel);

    modalLevel.textContent =
        "NÍVEL " + currentLevel;

    modalTitle.textContent =
        info.title;

    levelNumberEl.textContent =
        "NÍVEL " + currentLevel;

    levelSubtitleEl.textContent =
        info.subtitle;

    rewardValueEl.textContent =
        "🪙 " + getCurrentReward();

    if(currentLevel === 1){

        modalRule.textContent =
            "⚡ TOQUE ASSIM QUE O ALVO APARECER";

        modalDescription.textContent =
            "Espere o sinal. Quando ele aparecer, toque o mais rápido possível.";

    }

    else if(currentLevel === 2){

        modalRule.textContent =
