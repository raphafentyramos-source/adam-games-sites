/* =========================================================
   RECOMPENSA
========================================================= */

function getCurrentReward(){

    if(currentLevel <= 3){
        return 20;
    }

    if(currentLevel <= 7){
        return 30;
    }

    if(currentLevel === 8){

        if(currentTimerDuration <= 0){
            return 100;
        }

        const elapsed =
            performance.now() - levelStartTime;

        if(elapsed <= 10000){
            return 100;
        }

        return 75;
    }

    if(currentLevel === 9){

        const elapsed =
            performance.now() - levelStartTime;

        if(elapsed <= 10000){
            return 200;
        }

        if(elapsed <= 20000){
            return 150;
        }

        return 120;
    }

    return 0;
}


/* =========================================================
   INICIAR JOGO
========================================================= */

function startGame(){

    if(active){
        return;
    }

    if(coins < GAME_CONFIG.entryCost){

        showToast(
            "Você precisa de 30 moedas.",
            "error"
        );

        return;
    }

    if(chances < GAME_CONFIG.entryChance){

        showToast(
            "Você não tem chances suficientes.",
            "error"
        );

        return;
    }

    coins -= GAME_CONFIG.entryCost;

    chances -= GAME_CONFIG.entryChance;

    score = 0;

    currentLevel = 1;

    challengeNumber = 1;

    combo = 0;

    roundCount = 0;

    totalReaction = 0;

    reactionCount = 0;

    active = true;

    saveState();

    home.style.display = "none";

    game.classList.add("active");

    sound("start");

    showLevelIntro();
}


